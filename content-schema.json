{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SubjectContentSchema",
  "description": "Strict JSON schema for Study Buddy KKW subject content files.",
  "type": "object",
  "required": [
    "id",
    "name",
    "year",
    "icon",
    "lastUpdated",
    "units"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique subject identifier string."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name of the subject."
    },
    "year": {
      "type": "string",
      "enum": [
        "first-year",
        "second-year",
        "third-year",
        "fourth-year"
      ],
      "description": "Academic year category."
    },
    "icon": {
      "type": "string",
      "minLength": 1,
      "description": "Lucide React icon name."
    },
    "lastUpdated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO format date string (YYYY-MM-DD)."
    },
    "units": {
      "type": "array",
      "description": "List of curriculum units for the subject.",
      "items": {
        "type": "object",
        "required": [
          "unitNumber",
          "title",
          "resources"
        ],
        "additionalProperties": false,
        "properties": {
          "unitNumber": {
            "type": "integer",
            "minimum": 1,
            "description": "Unit number index."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Unit title."
          },
          "resources": {
            "type": "array",
            "description": "Resource materials for this unit.",
            "items": {
              "type": "object",
              "required": [
                "label",
                "type",
                "url"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Display label of the resource."
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "file",
                    "folder",
                    "video",
                    "question-bank"
                  ],
                  "description": "Type of resource."
                },
                "url": {
                  "type": "string",
                  "pattern": "^(https?://|#|/|mailto:).*$",
                  "description": "URL or target link for the resource."
                },
                "lastUpdated": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                  "description": "ISO format date string (YYYY-MM-DD)."
                }
              }
            }
          }
        }
      }
    },
    "bonus": {
      "type": "array",
      "description": "Optional list of bonus or PYQ resources.",
      "items": {
        "type": "object",
        "required": [
          "label",
          "type",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "Display label of the resource."
          },
          "type": {
            "type": "string",
            "enum": [
              "file",
              "folder",
              "video",
              "question-bank"
            ],
            "description": "Type of resource."
          },
          "url": {
            "type": "string",
            "pattern": "^(https?://|#|/|mailto:).*$",
            "description": "URL or target link for the resource."
          },
          "lastUpdated": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "ISO format date string (YYYY-MM-DD)."
          }
        }
      }
    },
    "quizzes": {
      "type": "array",
      "description": "Optional list of practice quiz questions.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "options",
          "correctIndex",
          "explanation"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "unitNumber": {
            "type": "integer",
            "minimum": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "correctIndex": {
            "type": "integer",
            "minimum": 0
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
